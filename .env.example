# ──────────────────────────────────────────────
# AEGIS — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# ── Supabase ──────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Your project URL  (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key — safe to use on the client
SUPABASE_ANON_KEY=your-anon-key-here

# ⚠️  SERVICE ROLE KEY — NEVER expose this to the frontend / mobile client.
# Only used in trusted server-side environments (edge functions, admin scripts).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── TomTom API ────────────────────────────────
# Server-side API key for routing, traffic, and nearby places search.
# NEVER expose this key to the frontend / client bundle.
TOMTOM_API_KEY=your-tomtom-api-key-here

# ── AI / Gemini API ───────────────────────────
# Server-side API key for "Explain My Situation" emergency summarization.
# (If omitted, Aegis automatically uses the built-in deterministic rules engine).
# NEVER expose this key to the frontend / client bundle.
GEMINI_API_KEY=your-gemini-api-key-here
